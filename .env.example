# Database
DATABASE_URL="mysql://root:root@localhost:3306/eco_logi"

# Redis — use REDIS_URL (Railway) ou host/port separados (local)
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:3333"
# Origens extras de CORS separadas por vírgula (opcional)
CORS_ORIGINS=""
NODE_ENV="development"
PORT="3333"

# Mapbox (necessário para cálculo de rotas e ETA)
MAPBOX_TOKEN=""

# Tracking
TRACKING_TOKEN_EXPIRES_IN_MINUTES="180"

# Geofence
GEOFENCE_RADIUS_METERS="100"

# Email / SMTP (RF23)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@ecologi.com.br"

# Storage (MVP: local. Produção/Railway: prefira s3 — disco local é efêmero)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# AWS_S3_BUCKET=""
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
