# Database
DATABASE_URL="mysql://root:root@localhost:3306/coleta_flow"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:3333"
NODE_ENV="development"
PORT="3333"

# Mapbox (necessário para cálculo de rotas e ETA)
MAPBOX_TOKEN=""

# Tracking
TRACKING_TOKEN_EXPIRES_IN_MINUTES="180"

# Geofence
GEOFENCE_RADIUS_METERS="100"

# Storage (MVP: local. Produção: S3)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
