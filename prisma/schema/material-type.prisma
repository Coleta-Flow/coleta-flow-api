// =============================================================================
// MaterialType — catálogo de tipos de material aceitos
// =============================================================================

model MaterialType {
  // — Identifiers
  id String @id @default(uuid())

  // — Data
  name           String
  description    String?
  unitOfMeasure  String?  // kg, m³, un (RF06)
  active         Boolean @default(true)

  // — Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // — Relations
  donorRequests DonorRequest[]

  @@map("material_types")
}
